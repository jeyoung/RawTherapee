FROM debian:12

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config git ca-certificates \
    libgtkmm-3.0-dev libglibmm-2.4-dev libcairomm-1.0-dev \
    libpangomm-1.4-dev libatkmm-1.6-dev \
    liblcms2-dev liblensfun-dev libexiv2-dev libfftw3-dev \
    libpng-dev libtiff-dev libjpeg-dev libjxl-dev libraw-dev \
    libiptcdata0-dev libcanberra-gtk3-dev librsvg2-dev \
    libexpat1-dev zlib1g-dev libbrotli-dev libinih-dev libgif-dev \
    libwebp-dev libwebpdemux2 \
    opencl-headers libtool automake autoconf \
    fakeroot dpkg-dev file rsync patchelf \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
