ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config git ca-certificates \
    libgtkmm-3.0-dev libglibmm-2.4-dev libcairomm-1.0-dev \
    libpangomm-1.4-dev libatkmm-1.6-dev \
    liblcms2-dev liblensfun-dev libexiv2-dev libfftw3-dev \
    libpng-dev libtiff-dev libjpeg-dev libraw-dev \
    libiptcdata0-dev libcanberra-gtk3-dev librsvg2-dev \
    libtool automake autoconf libexpat1-dev zlib1g-dev libbrotli-dev libinih-dev libgif-dev \
    libwebp-dev libwebpdemux2 libglib2.0-dev \
    opencl-headers patchelf fakeroot dpkg-dev file rsync \
    libgdk-pixbuf-2.0-dev libgtk-3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
